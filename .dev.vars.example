# Slack incoming webhook URL
# Get this from: https://api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_URL=

# Cloudflare API token
# Create a custom token at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions:
#   - Workers Builds Configuration: Read
#   - Workers Scripts: Read
#   - Queues: Edit              (auto-subscribe: cria assinaturas)
#   - Account Settings: Read    (auto-subscribe: só se ACCOUNT_ID ficar vazio)
#   - Cloudflare Pages: Read    (avisos de falha do Pages)
CLOUDFLARE_API_TOKEN=

# Opcional: ID da conta Cloudflare usada pelo auto-subscribe
ACCOUNT_ID=
