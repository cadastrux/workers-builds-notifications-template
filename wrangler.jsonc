/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "workers-builds-notifications-template",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	/**
	 * A cada 5 min: avisa falhas do Pages; a cada 15 min: cria Event Subscriptions para Workers
	 * novos com Workers Builds (ver src/pages.ts e src/subscriptions.ts).
	 */
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	/**
	 * KV para guardar as mensagens de falha e apagá-las quando a build passar.
	 * Sem "id": o wrangler cria o namespace automaticamente no primeiro deploy.
	 */
	"kv_namespaces": [{ "binding": "STATE" }],
	"assets": {
		"directory": "./public"
	},
	/**
	 * Queue Consumer Configuration
	 *
	 * IMPORTANT: Update the "queue" value below to match your queue name.
	 */
	"queues": {
		"consumers": [
			{
				"queue": "builds-event-subscriptions",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 3
			}
		]
	}
}
